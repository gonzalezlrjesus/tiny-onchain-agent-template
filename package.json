{
  "name": "tiny-onchain-agent-template",
  "version": "1.0.0",
  "description": "Tiny Observe > Reason > Act agent on Stellar testnet",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tsx agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --audit-level=high",
    "mutate": "stryker run",
    "duplicates": "npx -y jscpd --config .jscpd.json ."
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
