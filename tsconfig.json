{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist"
  },
  "include": [
    "agent.ts",
    "rpc.ts",
    "validate.ts",
    "config.ts",
    "x402-mock.ts",
    "errors.ts",
    "audit.ts",
    "vitest.config.ts",
    "validation.test.ts",
    "pairwise.test.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", ".stryker-tmp", "reports"]
}
